# ============================================
# MENTAL HEALTH CHATBOT - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# ============================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Server Configuration
SERVER_PORT=8002

# ============================================
# DATABASE CONFIGURATION (Supabase)
# ============================================

# Option 1: Full Database URL (recommended)
DATABASE_URL=postgresql://postgres:PASSWORD@PROJECT.supabase.co:5432/postgres

# Option 2: Individual Database Parameters
PG_HOST=localhost
PG_PORT=6543
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=

# ============================================
# JWT AUTHENTICATION
# ============================================

JWT_SECRET=change-this-in-production
JWT_EXP_MIN=120

# ============================================
# AI MODELS & APIs
# ============================================

# Google Gemini API
GEMINI_API_KEY=

# XAI (Grok) API
XAI_API_KEY=

# Ollama Configuration (for local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# ============================================
# TEXT-TO-SPEECH (TTS) CONFIGURATION
# ============================================

# Fish Audio TTS
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=0

# ============================================
# PSYCHOLOGIST FEATURE CONFIGURATION
# ============================================

# Enable/Disable Psychologist Feature
ENABLE_PSYCHOLOGIST_FEATURE=True

# Message Settings
MAX_MESSAGE_HISTORY=100
MESSAGE_REFRESH_INTERVAL=3000

# ============================================
# CORS Configuration
# ============================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8002,http://localhost:8002

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_FILE=app.log
